# Server Configuration
ENV=production
APP_NAME="TopGun Benchmark Server"

# Security
ADMIN_API_KEY="CHANGE_THIS_TO_A_VERY_SECURE_RANDOM_KEY_12345"

# Database Configuration
# Local SQLite (default):
DATABASE_URL="sqlite+aiosqlite:///./data/topgun.db"
# AWS PostgreSQL (RDS / Aurora):
# DATABASE_URL="postgresql+asyncpg://postgres:YourPassword@your-rds-endpoint.us-east-1.rds.amazonaws.com:5432/topgun"

# Competition Settings
DEFAULT_TEST_QUOTA=5
DEFAULT_GLOBAL_MODE="all" # "all", "train", "test", or "paused"
MAX_SUBMISSION_WINDOW_SECONDS=0 # 0 for no limit, or e.g. 120 for 2-minute deadline

# AWS S3 Storage (Leave blank to use local disk storage in data/ folder)
AWS_REGION="us-east-1"
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
S3_IMAGE_BUCKET=""
S3_SUBMISSION_BUCKET=""
